<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Historia.ScenarioLab.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="ColorBg" Color="#191925" />
        <SolidColorBrush x:Key="ColorChrome" Color="#13131D" />
        <SolidColorBrush x:Key="ColorSurface" Color="#1E1E2D" />
        <SolidColorBrush x:Key="ColorSurface2" Color="#2A2A3D" />
        <SolidColorBrush x:Key="ColorBorder" Color="#272739" />
        <SolidColorBrush x:Key="ColorBorderStrong" Color="#3B3B55" />
        <SolidColorBrush x:Key="ColorText" Color="#CFCFDC" />
        <SolidColorBrush x:Key="ColorTextMuted" Color="#9D9DB5" />
        <SolidColorBrush x:Key="ColorPrimary" Color="#0078D4" />
        <SolidColorBrush x:Key="ColorPrimaryHover" Color="#026EC1" />
        <SolidColorBrush x:Key="ColorDanger" Color="#F85149" />
        <SolidColorBrush x:Key="ColorListHover" Color="#272739" />
        <SolidColorBrush x:Key="ColorScrollbar" Color="#669D9DB5" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Classless button: transparent ground, 1px outline, plain text, subtle hover fill -->
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Primary button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource ColorPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Danger button -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorDanger}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}" />
        </Style>
        <Style Selector="Button.danger:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Secondary button -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderStrong}" />
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
        </Style>
        <Style Selector="Button.secondary:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Flat button -->
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
        </Style>
        <Style Selector="Button.flat:disabled">
            <Setter Property="Opacity" Value="0.28" />
        </Style>

        <!-- Menu, ContextMenu & Flyout theming -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
        </Style>
        <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
        </Style>
        <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource ColorSurface2}" />
        </Style>
        <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource ColorBorder}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <!-- ToolTip theming -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ColorText}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- ScrollBar theming -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ Border#VerticalRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ Border#HorizontalRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar[IsExpanded=true] /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ColorScrollbar}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource ColorTextMuted}" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource ColorText}" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorListHover}" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ColorSurface2}" />
        </Style>
    </Application.Styles>
</Application>
