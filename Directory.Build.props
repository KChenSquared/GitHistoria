<Project>

  <!--
    One build-output tree for the whole solution, rooted at the repository root. Every
    project's bin/ and obj/ are redirected to <repo>\bin\<ProjectName>\ and
    <repo>\obj\<ProjectName>\ — nothing is written under Historia.App\, Historia.Core\, or
    tests\Historia.Tests\.

    This must live in Directory.Build.props (imported before the SDK), not a .csproj, so
    BaseIntermediateOutputPath is set before NuGet restore runs.
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <BaseOutputPath>$(RepoRoot)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- The version comes from the nearest v* git tag. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Stamps the resolved version into the assembly so a test can tell MinVer ran. -->
  <Target Name="StampMinVerVersion" AfterTargets="MinVer" Condition="'$(MinVerVersion)' != ''">
    <ItemGroup>
      <AssemblyMetadata Include="MinVerVersion" Value="$(MinVerVersion)" />
    </ItemGroup>
  </Target>

</Project>
