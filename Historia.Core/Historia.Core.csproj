<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Historia</RootNamespace>
    <AssemblyName>Historia.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The portable half of Historia. No UI framework — not WPF, not Avalonia.
         Colour/point value types are the local Rgb / PointD structs, not Avalonia.Base, so
         this assembly *cannot* take a UI dependency by accident (it would not compile). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned, no floating wildcard. -->
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <!-- RepositoryContext resolves per-repo collaborators from the app's IServiceProvider. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- Headless VT/ANSI emulator + pseudoterminal. Both are framework-free process /
         parsing libraries, so Core purity holds. -->
    <PackageReference Include="XTerm.NET" Version="2.0.2" />
    <PackageReference Include="Porta.Pty" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal storage-resolution seams are exercised from the test project. -->
    <InternalsVisibleTo Include="Historia.Tests" />
  </ItemGroup>

</Project>
