<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Historia.ViewModels;assembly=Historia.Core"
             x:Class="Historia.Views.RebaseEditorView"
             x:DataType="vm:RebaseEditorViewModel"
             Background="{DynamicResource ColorChrome}">
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="24" MaxWidth="760">
            <TextBlock Classes="text"
                       Text="Interactive rebase"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <TextBlock Classes="text"
                       IsVisible="{Binding HasError}"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ColorDanger}" />

            <TextBlock Classes="text muted"
                       IsVisible="{Binding IsLoaded}"
                       Text="{Binding Summary}"
                       FontSize="12" />

            <ItemsControl IsVisible="{Binding IsLoaded}"
                          ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RebaseTodoItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,120,*" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▲"
                                        Command="{Binding MoveUpCommand}"
                                        Padding="6,0" />
                                <Button Content="▼"
                                        Command="{Binding MoveDownCommand}"
                                        Padding="6,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="90"
                                      Margin="6,0"
                                      ItemsSource="{Binding Actions}"
                                      SelectedItem="{Binding Action}" />
                            <TextBlock Grid.Column="2"
                                       Classes="text muted"
                                       Text="{Binding ShortId}"
                                       FontSize="11" />
                            <TextBlock Grid.Column="3"
                                       Classes="text"
                                       Text="{Binding Message}"
                                       FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox IsVisible="{Binding IsLoaded}"
                      Content="Autostash local changes"
                      IsChecked="{Binding Autostash}" />

            <StackPanel IsVisible="{Binding IsLoaded}"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Classes="primary"
                        Content="Start rebase"
                        Command="{Binding StartCommand}"
                        Cursor="Hand" />
                <Button Classes="secondary"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
