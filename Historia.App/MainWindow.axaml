<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:Historia.Controls"
        mc:Ignorable="d"
        x:Class="Historia.MainWindow"
        Title="Historia" Icon="/Assets/Historia.ico" Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorBg}">
    <!-- Shell composition: native chrome + status bar; body is
         [sidebar] | [native commit graph] | [detail].
         Column widths are driven from code-behind (InitBodyLayout). -->
    <!-- 3-row grid: app band, body, status bar. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: the app band. -->
        <ContentControl Grid.Row="0" x:Name="AppBandHost" MinHeight="32"
                        Background="{DynamicResource ColorChrome}" />

        <!-- Row 1: the body grid with two rows: row 0 for the split shortcut bars, row 1 for the panes.
             The centre column and both dividers span both rows so the graph starts directly under the app band. -->
        <Grid Grid.Row="1" x:Name="BodyGrid" RowDefinitions="Auto,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="0" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="1.35*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left shortcut bar above the sidebar -->
            <ContentControl Grid.Row="0" Grid.Column="0" x:Name="LeftShortcutsHost" />
            <ContentControl Grid.Row="1" Grid.Column="0" x:Name="SidebarHost"
                            Background="{DynamicResource ColorChrome}" />

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" x:Name="LeftDivider" Cursor="SizeWestEast"
                    Background="{DynamicResource ColorBorder}"
                    PointerPressed="OnDividerPressed" PointerMoved="OnLeftDividerMoved"
                    PointerReleased="OnDividerReleased" PointerCaptureLost="OnDividerCaptureLost" />

            <!-- Centre column: spans both rows so it starts directly under the app band.
                 Contains the graph / diff region with the terminal dock docked to its
                 bottom edge only. The dock collapses to Height=0 when closed. -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" RowDefinitions="*,Auto">
                <ContentControl Grid.Row="0" x:Name="CenterHost"
                                Background="{DynamicResource ColorBg}" />
                <ContentControl Grid.Row="1" x:Name="TerminalDockHost" />
            </Grid>

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" x:Name="RightDivider" Cursor="SizeWestEast"
                    Background="{DynamicResource ColorBorder}"
                    PointerPressed="OnDividerPressed" PointerMoved="OnRightDividerMoved"
                    PointerReleased="OnDividerReleased" PointerCaptureLost="OnDividerCaptureLost" />

            <!-- Column 4: Right shortcut bar above the detail pane -->
            <ContentControl Grid.Row="0" Grid.Column="4" x:Name="RightShortcutsHost" />
            <ContentControl Grid.Row="1" Grid.Column="4" x:Name="DetailHost"
                            Background="{DynamicResource ColorChrome}" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource ColorSurface}"
                BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,1,0,0"
                Padding="12,4">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11"
                       Foreground="{DynamicResource ColorTextMuted}" />
        </Border>

        <!-- Window-level modal layer: spans all rows so app-modal prompts
             (first-run identity import) dim and centre over the whole window, not
             inside one body panel. Empty and click-through until a prompt is shown. -->
        <Panel Grid.Row="0" Grid.RowSpan="3" x:Name="ModalOverlayHost" />
    </Grid>
</Window>
